{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fahs-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // قاعدة البيانات: إن لم تظهر تلقائياً ضع database_id بعد إنشائها (انظر README)
  "d1_databases": [
    { "binding": "DB", "database_name": "fahs-db" }
  ],
  // مهمة كل دقيقة لإكمال الإذاعات الكبيرة على دفعات
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BROADCAST_BATCH": "25"
  }
}
