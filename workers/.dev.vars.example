# للتجربة المحلية فقط (انسخه إلى .dev.vars). في Cloudflare تضاف كأسرار من لوحة التحكم.
BOT_TOKEN=123456:ABC...
OWNER_ID=123456789
# اختياري: معرّفات مشرفين إضافيين مفصولة بفواصل
ADMIN_IDS=
WEBHOOK_SECRET=اكتب_نص_عشوائي_طويل_بحروف_وأرقام
VT_API_KEY=
# اتركها 0 ما لم توافق صراحة على إرسال الروابط إلى VirusTotal
VT_EXTERNAL_SCAN_CONSENT=0
